# Только для API-маршрута: скопируйте в .env и заполните своими данными провайдера.
# Для Codex/Claude Code/Cursor по подписке и application MCP API-ключ не требуется.
OPENAI_API_KEY=sk-...
# База прокси воркшопа. Новый оркестратор требует strict function calling;
# совместимость других OpenAI-compatible провайдеров нужно проверять отдельно.
OPENAI_BASE_URL=https://llm.workshop.example.com/v1
# Референсный replay-профиль; результаты и ограничения:
# docs/model-orchestrator.md. Модель не гарантирует верный RCA.
MODEL=gpt-4.1
# Модель на роль (по умолчанию = MODEL): fast — разбор репорта и вердикт, strong — улики и код
# MODEL_FAST=gpt-4.1
# MODEL_STRONG=gpt-4.1

# Kind / Boutique (путь к папке microservices-demo внутри монорепо)
KUBECTL_CONTEXT=kind-qai-boutique
BOUTIQUE_NAMESPACE=default
# Можно не указывать: по умолчанию ../microservices-demo относительно workshop/
# BOUTIQUE_ROOT=/Users/YOU/heisenbug-2026-workshop/microservices-demo
# BOUTIQUE_ROOT=C:\Users\YOU\Downloads\heisenbug-2026-workshop\microservices-demo
# Второй разрешённый корень кода: по умолчанию services/order-worker относительно workshop/
# ORDER_WORKER_ROOT=/Users/YOU/heisenbug-2026-workshop/workshop/services/order-worker

# Workshop stack (после ./hack/workshop/ports-workshop.sh)
TEMPO_URL=http://127.0.0.1:3200
PROM_URL=http://127.0.0.1:9090
TEMPORAL_HOST=127.0.0.1:7233

# Наблюдаемость самого агента: спаны прогона в Tempo (service.name=qai-agent). AGENT_TRACES=0 выключает.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
AGENT_TRACES=1
# Цена за 1M токенов для печати стоимости прогона (0 = только токены)
PRICE_IN_PER_1M=0
PRICE_OUT_PER_1M=0
# Устойчивость к залу: ретраи 429/5xx с backoff и таймаут запроса
LLM_MAX_RETRIES=6
LLM_TIMEOUT_S=120

# Cursor GitHub MCP (.cursor/mcp.json) — не коммитить токен
# export GITHUB_TOKEN=ghp_...

# MCP opt-in: абсолютный путь; без этой переменной остаётся legacy CLI режим.
# QAI_MCP_CONFIG=/absolute/path/heisenbug_2026/workshop/mcp/replay.json
# Для live нужен отдельный read-only kubeconfig, см. docs/k8sgpt-mcp.md.
# QAI_KUBECONFIG=/absolute/path/qai-training-readonly.kubeconfig
